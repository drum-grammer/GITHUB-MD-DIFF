{
  "name": "github-md-diff",
  "version": "1.5.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.10.1",
  "scripts": {
    "build": "node build.mjs",
    "dev:chrome": "node scripts/dev-chrome.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "e2e": "node build.mjs && playwright test",
    "e2e:login": "node e2e/login.mjs",
    "icons": "node scripts/icons.mjs",
    "package": "node scripts/package.mjs",
    "release": "node scripts/release.mjs",
    "store:upload": "node scripts/store-upload.mjs",
    "canary": "node build.mjs && node scripts/canary.mjs",
    "explore:pick": "node scripts/explore-pick.mjs",
    "explore": "node build.mjs && node scripts/explore.mjs",
    "explore:report": "node scripts/explore-report.mjs",
    "perf": "node build.mjs && node scripts/perf.mjs",
    "testbed:setup": "node scripts/testbed-setup.mjs",
    "testbed": "node build.mjs && playwright test -c testbed/playwright.config.ts",
    "testbed:report": "node scripts/testbed-report.mjs",
    "verify": "node scripts/verify.mjs",
    "store:assets": "node build.mjs && node store/capture.mjs en && node store/capture.mjs ko && node store/compose.mjs en && node store/compose.mjs ko"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/chrome": "^0.3.4",
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^26.6.4",
    "esbuild": "^0.28.2",
    "jsdom": "^30.1.2",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "markdown-it": "^14.3.2"
  }
}
