{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["node", "chrome"],
    "strict": true,
    "allowJs": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "skipLibCheck": true,
    "paths": { "@markdown-diff-cat/engine": ["../engine/src/index.ts"] }
  },
  "include": ["src", "test", "e2e", "*.ts", "../engine/src/shims.d.ts"]
}
