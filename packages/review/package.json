{
  "name": "markdown-diff-cat",
  "version": "1.7.0",
  "description": "Review changed Markdown as a rendered diff in a local page, and hand your block comments to a coding agent.",
  "type": "module",
  "bin": { "markdown-diff-cat": "dist/markdown-diff-cat.mjs" },
  "files": ["dist/markdown-diff-cat.mjs", "README.md", "LICENSE"],
  "engines": { "node": ">=22.19" },
  "license": "MIT",
  "repository": { "type": "git", "url": "git+https://github.com/drum-grammer/GITHUB-MD-DIFF.git", "directory": "packages/review" },
  "homepage": "https://github.com/drum-grammer/GITHUB-MD-DIFF/tree/main/packages/review#readme",
  "bugs": "https://github.com/drum-grammer/GITHUB-MD-DIFF/issues",
  "keywords": ["markdown", "diff", "review", "rendered", "agent", "claude-code", "codex"],
  "scripts": {
    "build": "node build.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "e2e": "node build.mjs && playwright test"
  },
  "devDependencies": {
    "@markdown-diff-cat/engine": "workspace:*",
    "@playwright/test": "^1.63.0",
    "@types/chrome": "^0.3.4",
    "@types/node": "^26.6.4",
    "esbuild": "^0.28.2",
    "github-markdown-css": "5.9.0",
    "jsdom": "^30.1.2",
    "mermaid": "12.2.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
